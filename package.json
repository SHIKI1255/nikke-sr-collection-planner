{
  "name": "nikke-sr-collection-planner",
  "version": "1.4.0",
  "private": true,
  "description": "NIKKE SR收藏品库存自适应强化规划器",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
